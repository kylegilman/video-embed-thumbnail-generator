{
    "name": "kylegilman/video-embed-thumbnail-generator",
    "description": "Makes video thumbnails, allows resolution switching, and embeds responsive self-hosted videos and galleries.",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4",
        "symfony/process": "^5.4",
        "freemius/wordpress-sdk": "^2.6",
        "woocommerce/action-scheduler": "^3.5"
    },
    "license": "GNU General Public License",
    "autoload": {
        "psr-4": {
            "Videopack\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Kyle Gilman",
            "email": "kylegilman@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "wp-phpunit/wp-phpunit": "^7.0",
        "yoast/phpunit-polyfills": "^4.0",
        "phpstan/phpstan": "^2.2",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "squizlabs/php_codesniffer": "^3.7",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/php-compatibility": "^9.3",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "scripts": {
        "analyze": "phpstan analyze --memory-limit=-1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4"
        }
    }
}
