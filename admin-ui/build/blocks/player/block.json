{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "videopack/player",
  "title": "Videopack Player",
  "category": "media",
  "icon": "format-video",
  "parent": [
    "videopack/player-container"
  ],
  "allowedBlocks": [
    "videopack/watermark",
    "videopack/title"
  ],
  "usesContext": [
    "videopack/id",
    "videopack/postId",
    "videopack/attachmentId",
    "videopack/src",
    "videopack/poster",
    "videopack/title",
    "videopack/caption",
    "videopack/width",
    "videopack/height",
    "videopack/autoplay",
    "videopack/controls",
    "videopack/loop",
    "videopack/muted",
    "videopack/playsinline",
    "videopack/preload",
    "videopack/volume",
    "videopack/auto_res",
    "videopack/sources",
    "videopack/source_groups",
    "videopack/text_tracks",
    "videopack/playback_rate",
    "videopack/default_ratio",
    "videopack/fixed_aspect",
    "videopack/fullwidth",
    "videopack/textAlign",
    "videopack/downloadlink",
    "videopack/overlay_title",
    "videopack/showBackground",
    "videopack/views",
    "videopack/embedcode",
    "videopack/embedlink",
    "videopack/embed_method",
    "videopack/showCaption",
    "videopack/title_position",
    "videopack/restartCount",
    "videopack/isPreview",
    "videopack/pauseothervideos",
    "videopack/right_click",
    "videopack/skip_buttons",
    "videopack/gifmode",
    "videopack/resize",
    "videopack/pixel_ratio",
    "videopack/schema",
    "videopack/skin",
    "videopack/instanceId",
    "videopack/isInsidePlayerOverlay",
    "videopack/isInsidePlayerContainer",
    "videopack/watermark",
    "videopack/watermark_styles",
    "videopack/watermark_link_to"
  ],
  "editorStyle": "file:./index.css",
  "attributes": {
    "isInsidePlayerOverlay": {
      "type": "boolean",
      "default": true
    },
    "isPreview": {
      "type": "boolean",
      "default": false
    }
  },
  "example": {
    "attributes": {
      "isPreview": true
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "lock": true
  },
  "textdomain": "video-embed-thumbnail-generator",
  "editorScript": "file:./index.js"
}